{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "scrobble-blocks/top-albums",
	"version": "1.1.0",
	"title": "Last.fm: Top Albums",
	"category": "widgets",
	"icon": "album",
	"description": "Displays your most played albums from Last.fm over a chosen period, as a featured mosaic, a grid or a ranked list.",
	"keywords": ["lastfm", "music", "top albums", "albums", "charts", "scrobble"],
	"textdomain": "scrobbled-blocks",
	"attributes": {
		"numberOfItems": {
			"type": "number",
			"default": 5
		},
		"period": {
			"type": "string",
			"default": "7day"
		},
		"layout": {
			"type": "string",
			"default": "featured"
		},
		"gridColumns": {
			"type": "number",
			"default": 3
		},
		"showArtwork": {
			"type": "boolean",
			"default": true
		},
		"showPlaycount": {
			"type": "boolean",
			"default": true
		},
		"linkToLastFm": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
